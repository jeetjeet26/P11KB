# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=your_supabase_db_url_here

# OpenAI Configuration (Required for ad copy generation and embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=your_openai_assistant_id_here

# OpenAI-only deployment: no Gemini required
# (Remove any GEMINI_* usage from your environment)

# Web Crawling Configuration
CRAWLING_MAX_PAGES_PER_SITE=15
CRAWLING_TIMEOUT_SECONDS=30
CRAWLING_DELAY_MS=1000
CRAWLING_USER_AGENT="P11RAG-Bot/1.0"

# Feature Flags
ENABLE_WEB_CRAWLING=true
ENABLE_ASYNC_PROCESSING=true
ENABLE_ADVANCED_CHUNKING=true

# Development/Debug
NODE_ENV=development
NEXT_PUBLIC_DEBUG_MODE=false




