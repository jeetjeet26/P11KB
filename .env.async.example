# Phase 2: Async Job Pattern Environment Configuration
# Copy this to your .env.local and adjust values as needed

# Enable async generation for complex campaigns
ENABLE_ASYNC_GENERATION=true

# Existing environment variables (ensure these are set)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Timeout configurations (adjust for async processing)
LLM_REQUEST_DEADLINE_MS=300000  # 5 minutes for async jobs
LLM_PARALLEL_FALLBACK_DELAY_MS=4000
LLM_CIRCUIT_BREAKER_TTL_MS=120000

# Match count for vector searches (balance speed vs quality)
MATCH_COUNT=10

# Gemini model selection (flash is faster, pro is more accurate)
GEMINI_MODEL=gemini-1.5-flash

# Database configuration
# Enable real-time subscriptions in your Supabase project dashboard
# Tables with real-time enabled: campaign_generation_jobs
